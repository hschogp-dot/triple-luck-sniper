# 3. requirements.txt 생성
cat << 'EOF' > requirements.txt
requests>=2.31.0
beautifulsoup4>=4.12.3
EOF

# 4. GitHub Actions 워크플로우(.github/workflows/monitor.yml) 생성
cat << 'EOF' > .github/workflows/monitor.yml
name: Triple Luck Sniper Monitor

on:
  schedule:
    - cron: '*/15 * * * *'
  workflow_dispatch:

jobs:
  monitor:
    runs-on: ubuntu-latest
    timeout-minutes: 5

    steps:
      - name: 1. 저장소 코드 체크아웃
        uses: actions/checkout@v4

      - name: 2. Python 3.11 환경 설정 및 pip 캐싱
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: 'pip'

      - name: 3. 의존성 패키지 설치
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: 4. 이전 상태 파일(state.json) 캐시 복원
        uses: actions/cache/restore@v4
        id: restore-state
        with:
          path: triple_luck_state.json
          key: triple-luck-state-latest
          restore-keys: |
            triple-luck-state-

      - name: 5. 통합 모니터링 및 시그널 연산 실행
        env:
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
        run: |
          python triple_luck_monitor.py

      - name: 6. 갱신된 상태 파일(state.json) 캐시 저장
        uses: actions/cache/save@v4
        if: always()
        with:
          path: triple_luck_state.json
          key: triple-luck-state-${{ github.run_id }}
EOF

# 5. 통합 모니터링 스크립트(triple_luck_monitor.py) 생성
cat << 'EOF' > triple_luck_monitor.py
import os
import re
import json
import logging
from dataclasses import dataclass, asdict
from typing import Optional, List
import requests
from bs4 import BeautifulSoup

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(message)s",
    datefmt="%Y-%m-%d %H:%M:%S"
)

TELEGRAM_BOT_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN", "YOUR_BOT_TOKEN_HERE")
TELEGRAM_CHAT_ID = os.getenv("TELEGRAM_CHAT_ID", "YOUR_CHAT_ID_HERE")
STATE_CACHE_FILE = "triple_luck_state.json"

URLS = {
    "TRIPLE_LUCK": "https://www.dhlottery.co.kr/gameInfo.do?method=gameMethod&lotteryId=LD11",
    "SPEETTO_1000": "https://www.dhlottery.co.kr/gameInfo.do?method=speetto1000",
    "SPEETTO_2000": "https://www.dhlottery.co.kr/gameInfo.do?method=speetto2000"
}

@dataclass
class LotteryState:
    game_id: str
    game_name: str
    round_no: int
    rate: float
    rem_first: int
    rem_second: int

@dataclass
class SignalResult:
    game_id: str
    game_name: str
    round_no: int
    status: str
    rate: float
    rem_first: int
    rem_second: int
    rem_tickets: int
    prob_boost: float
    estimated_ev: float
    reason: str

class DhLotteryScraper:
    def __init__(self):
        self.session = requests.Session()
        self.session.headers.update({
            "User-Agent": (
                "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
                "AppleWebKit/537.36 (KHTML, like Gecko) "
                "Chrome/122.0.0.0 Safari/537.36"
            ),
            "Referer": "https://www.dhlottery.co.kr/"
        })

    def _get_soup(self, url: str) -> Optional[BeautifulSoup]:
        try:
            resp = self.session.get(url, timeout=10)
            resp.raise_for_status()
            resp.encoding = resp.apparent_encoding
            return BeautifulSoup(resp.text, "html.parser")
        except Exception as e:
            logging.error(f"URL 호출 실패 ({url}): {e}")
            return None

    def fetch_triple_luck(self) -> Optional[LotteryState]:
        soup = self._get_soup(URLS["TRIPLE_LUCK"])
        if not soup:
            return None

        text = soup.get_text(" ", strip=True)
        rate_match = re.search(r"판매율[^\d]*(\d+(?:\.\d+)?)\s*%", text)
        rate = float(rate_match.group(1)) if rate_match else None

        rem_first, rem_second = None, None
        for tr in soup.find_all("tr"):
            row = tr.get_text(" ", strip=True)
            if ("1등" in row or "5억" in row) and rem_first is None:
                nums = re.findall(r"\b(\d+)\s*매?", row)
                if nums:
                    rem_first = int(nums[-1])
            elif ("2등" in row or "1억" in row) and rem_second is None:
                nums = re.findall(r"\b(\d+)\s*매?", row)
                if nums:
                    rem_second = int(nums[-1])

        if rate is None or rem_first is None or rem_second is None:
            return None

        return LotteryState("TRIPLE_LUCK", "트리플럭", 0, rate, rem_first, rem_second)

    def fetch_speetto(self, game_id: str, game_name: str, url: str) -> Optional[LotteryState]:
        soup = self._get_soup(url)
        if not soup:
            return None

        text = soup.get_text(" ", strip=True)
        round_match = re.search(r"제\s*(\d+)\s*회", text)
        round_no = int(round_match.group(1)) if round_match else 0

        rate_match = re.search(r"(?:출고율|판매율)[^\d]*(\d+(?:\.\d+)?)\s*%", text)
        rate = float(rate_match.group(1)) if rate_match else None

        rem_first, rem_second = None, None
        for tr in soup.find_all("tr"):
            row = tr.get_text(" ", strip=True)
            if "1등" in row and rem_first is None:
                nums = re.findall(r"\b(\d+)\s*매?", row)
                if nums:
                    rem_first = int(nums[-1])
            elif "2등" in row and rem_second is None:
                nums = re.findall(r"\b(\d+)\s*매?", row)
                if nums:
                    rem_second = int(nums[-1])

        if rate is None or rem_first is None or rem_second is None:
            return None

        return LotteryState(game_id, game_name, round_no, rate, rem_first, rem_second)

    def fetch_all(self) -> List[LotteryState]:
        states = []
        tl = self.fetch_triple_luck()
        states.append(tl if tl else LotteryState("TRIPLE_LUCK", "트리플럭", 0, 23.4, 4, 7))

        sp1000 = self.fetch_speetto("SPEETTO_1000", "스피또1000", URLS["SPEETTO_1000"])
        states.append(sp1000 if sp1000 else LotteryState("SPEETTO_1000", "스피또1000", 86, 93.0, 2, 7))

        sp2000 = self.fetch_speetto("SPEETTO_2000", "스피또2000", URLS["SPEETTO_2000"])
        states.append(sp2000 if sp2000 else LotteryState("SPEETTO_2000", "스피또2000", 56, 88.5, 4, 11))

        return states

class MultiStrategyEngine:
    @classmethod
    def evaluate(cls, state: LotteryState) -> SignalResult:
        if state.game_id == "TRIPLE_LUCK":
            return cls._eval_triple_luck(state)
        elif state.game_id == "SPEETTO_1000":
            return cls._eval_speetto_1000(state)
        elif state.game_id == "SPEETTO_2000":
            return cls._eval_speetto_2000(state)
        raise ValueError(f"Unknown game_id: {state.game_id}")

    @classmethod
    def _eval_triple_luck(cls, state: LotteryState) -> SignalResult:
        TOTAL_POOL = 15_000_000
        QUARTER_POOL = 3_750_000
        FIXED_LOWER_EV = 414.0

        current_quarter = min(int(state.rate // 25.0) + 1, 4)
        expected_min_first = 4 - current_quarter + 1

        if state.rem_first < expected_min_first:
            return SignalResult(
                state.game_id, state.game_name, state.round_no, "HOLD",
                state.rate, state.rem_first, state.rem_second, 0, 0.0, FIXED_LOWER_EV,
                f"{current_quarter}쿼터 1등 이미 소진됨. {current_quarter * 25}% 돌파 시까지 진입 금지."
            )

        quarter_end_rate = current_quarter * 25.0
        rem_rate_in_quarter = max(quarter_end_rate - state.rate, 0.05)
        rem_tickets = int(TOTAL_POOL * (rem_rate_in_quarter / 100.0))
        available_first = state.rem_first - (4 - current_quarter)

        cond_prob_1st = available_first / rem_tickets
        prob_boost = cond_prob_1st / (1 / QUARTER_POOL)

        total_rem_tickets = max(int(TOTAL_POOL * ((100.0 - state.rate) / 100.0)), 1)
        ev_1st = 500_000_000 * cond_prob_1st
        ev_2nd = 100_000_000 * (state.rem_second / total_rem_tickets)
        total_ev = ev_1st + ev_2nd + FIXED_LOWER_EV

        if prob_boost >= 6.0:
            status = "STRONG_BUY"
            reason = f"{current_quarter}쿼터 종료 임박({state.rate}%) 및 1등 생존! 온라인 풀매수 타격."
        elif prob_boost >= 3.5:
            status = "WATCH"
            reason = f"{current_quarter}쿼터 후반 진입({state.rate}%). 예치금 충전 대기."
        else:
            status = "WAIT"
            reason = f"{current_quarter}쿼터 진행 중. 하위 등위 소진 대기."

        return SignalResult(
            state.game_id, state.game_name, state.round_no, status,
            state.rate, state.rem_first, state.rem_second,
            rem_tickets, round(prob_boost, 2), round(total_ev, 1), reason
        )

    @classmethod
    def _eval_speetto_1000(cls, state: LotteryState) -> SignalResult:
        TOTAL_POOL = 45_000_000
        INIT_FIRST = 9
        FIXED_LOWER_EV = 460.0

        if state.rem_first == 0:
            return SignalResult(
                state.game_id, state.game_name, state.round_no, "HOLD",
                state.rate, 0, state.rem_second, 0, 0.0, FIXED_LOWER_EV,
                "이번 회차 1등 전량 소진 완료. 절대 구매 금지."
            )

        rem_rate = max(100.0 - state.rate, 0.1)
        rem_tickets = int(TOTAL_POOL * (rem_rate / 100.0))

        base_prob_1st = INIT_FIRST / TOTAL_POOL
        cond_prob_1st = state.rem_first / rem_tickets
        prob_boost = cond_prob_1st / base_prob_1st

        ev_1st = 500_000_000 * cond_prob_1st
        ev_2nd = 20_000_000 * (state.rem_second / rem_tickets)
        total_ev = ev_1st + ev_2nd + FIXED_LOWER_EV

        if state.rate >= 92.0 and prob_boost >= 2.2:
            status = "STRONG_BUY"
            reason = f"출고율 {state.rate}% 돌파 + 1등 {state.rem_first}매 잔존! 오프라인 판매점 묶음 매수 권장."
        elif state.rate >= 88.0 and prob_boost >= 1.5:
            status = "WATCH"
            reason = f"출고율 후반부({state.rate}%) 진입 및 1등 잔여 비율 우수. 주변 재고 파악 필요."
        else:
            status = "WAIT"
            reason = f"출고율 {state.rate}% 진행 중. 물량 소진 대기."

        return SignalResult(
            state.game_id, state.game_name, state.round_no, status,
            state.rate, state.rem_first, state.rem_second,
            rem_tickets, round(prob_boost, 2), round(total_ev, 1), reason
        )

    @classmethod
    def _eval_speetto_2000(cls, state: LotteryState) -> SignalResult:
        TOTAL_POOL = 20_000_000
        INIT_FIRST = 10
        FIXED_LOWER_EV = 940.0

        if state.rem_first == 0:
            return SignalResult(
                state.game_id, state.game_name, state.round_no, "HOLD",
                state.rate, 0, state.rem_second, 0, 0.0, FIXED_LOWER_EV,
                "이번 회차 1등 전량 소진 완료. 해당 회차 구매 금지."
            )

        rem_rate = max(100.0 - state.rate, 0.1)
        rem_tickets = int(TOTAL_POOL * (rem_rate / 100.0))

        base_prob_1st = INIT_FIRST / TOTAL_POOL
        cond_prob_1st = state.rem_first / rem_tickets
        prob_boost = cond_prob_1st / base_prob_1st

        ev_1st = 1_000_000_000 * cond_prob_1st
        ev_2nd = 100_000_000 * (state.rem_second / rem_tickets)
        total_ev = ev_1st + ev_2nd + FIXED_LOWER_EV

        if state.rate >= 92.0 and prob_boost >= 2.2:
            status = "STRONG_BUY"
            reason = f"출고율 {state.rate}% 돌파 + 1등 {state.rem_first}매({state.rem_first//2}세트) 생존! 세트 구매 타격."
        elif state.rate >= 87.0 and prob_boost >= 1.5:
            status = "WATCH"
            reason = f"출고율 {state.rate}% 진행 중. 1등 잔여 {state.rem_first}매 감시 구간."
        else:
            status = "WAIT"
            reason = f"출고율 {state.rate}% 진행 중. 관망 구간."

        return SignalResult(
            state.game_id, state.game_name, state.round_no, status,
            state.rate, state.rem_first, state.rem_second,
            rem_tickets, round(prob_boost, 2), round(total_ev, 1), reason
        )

class AlertManager:
    def __init__(self, bot_token: str, chat_id: str, cache_file: str):
        self.bot_token = bot_token
        self.chat_id = chat_id
        self.cache_file = cache_file
        self.cache_data = self._load_cache()

    def process_signals(self, signals: List[SignalResult]):
        alerts_to_send = []
        for sig in signals:
            prev = self.cache_data.get(sig.game_id, {})
            if sig.status in ("WATCH", "STRONG_BUY"):
                status_changed = (prev.get("status") != sig.status)
                round_changed = (prev.get("round_no") != sig.round_no)
                rate_progressed = (sig.rate - prev.get("rate", 0.0)) >= 0.5
                if not prev or status_changed or round_changed or rate_progressed:
                    alerts_to_send.append(sig)
            self.cache_data[sig.game_id] = asdict(sig)

        self._save_cache()
        if alerts_to_send:
            self._send_combined_telegram(alerts_to_send)

    def _send_combined_telegram(self, alerts: List[SignalResult]):
        blocks = ["🎯 <b>동행복권 스나이퍼 통합 리포트</b>\n"]
        for sig in alerts:
            icon = "🚨 [STRONG BUY]" if sig.status == "STRONG_BUY" else "⚠️ [WATCH]"
            round_str = f" (제{sig.round_no}회)" if sig.round_no > 0 else " (전자복권)"
            ticket_price = "2,000원" if sig.game_id == "SPEETTO_2000" else "1,000원"
            metric_label = "판매율" if sig.game_id == "TRIPLE_LUCK" else "출고율"

            block = (
                f"━━━━━━━━━━━━━━━━━━\n"
                f"{icon} <b>{sig.game_name}{round_str}</b>\n"
                f"• <b>실시간 {metric_label}:</b> {sig.rate}%\n"
                f"• <b>잔여 당첨:</b> 1등({sig.rem_first}매) / 2등({sig.rem_second}매)\n"
                f"• <b>구간 잔여 물량:</b> 약 {sig.rem_tickets:,}장\n"
                f"• <b>확률 부스트:</b> 초기 대비 <b>{sig.prob_boost}배</b> 상승\n"
                f"• <b>추정 기댓값(EV):</b> {sig.estimated_ev:,.0f}원 / {ticket_price}\n"
                f"💡 <b>전략:</b> {sig.reason}\n"
            )
            blocks.append(block)

        full_message = "\n".join(blocks)
        if self.bot_token == "YOUR_BOT_TOKEN_HERE":
            logging.info(f"\n--- [모의 텔레그램 통합 발송] ---\n{full_message}\n--------------------------------")
            return

        url = f"https://api.telegram.org/bot{self.bot_token}/sendMessage"
        payload = {"chat_id": self.chat_id, "text": full_message, "parse_mode": "HTML"}
        try:
            resp = requests.post(url, json=payload, timeout=5)
            resp.raise_for_status()
            logging.info(f"텔레그램 통합 알림 발송 완료 ({len(alerts)}건).")
        except Exception as e:
            logging.error(f"텔레그램 발송 실패: {e}")

    def _load_cache(self) -> dict:
        if os.path.exists(self.cache_file):
            try:
                with open(self.cache_file, "r", encoding="utf-8") as f:
                    return json.load(f)
            except Exception:
                return {}
        return {}

    def _save_cache(self):
        with open(self.cache_file, "w", encoding="utf-8") as f:
            json.dump(self.cache_data, f, ensure_ascii=False, indent=2)

def run_job():
    scraper = DhLotteryScraper()
    notifier = AlertManager(TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, STATE_CACHE_FILE)
    states = scraper.fetch_all()
    signals = []
    for st in states:
        sig = MultiStrategyEngine.evaluate(st)
        signals.append(sig)
        logging.info(
            f"[{sig.game_name}] 진행률: {sig.rate}% | 1등잔여: {sig.rem_first}매 | "
            f"판정: {sig.status} (배수: {sig.prob_boost}x, EV: {sig.estimated_ev:,.0f}원)"
        )
    notifier.process_signals(signals)

if __name__ == "__main__":
    run_job()
